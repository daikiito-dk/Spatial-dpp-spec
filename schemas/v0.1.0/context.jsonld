{
  "@context": {
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "http://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sdpp": "https://spatial-dpp.org/terms/",

    "SpatialDppDocument": "sdpp:SpatialDppDocument",
    "SpatialObject": "sdpp:SpatialObject",

    "metadata": "sdpp:metadata",
    "spec_version": "sdpp:specVersion",
    "document_id": { "@id": "sdpp:documentId", "@type": "@id" },
    "name": "schema:name",
    "created": { "@id": "sdpp:created", "@type": "xsd:dateTime" },
    "author": "schema:author",
    "language": "schema:inLanguage",

    "objects": { "@id": "sdpp:hasObject", "@container": "@set" },
    "id": "@id",
    "label": "skos:prefLabel",

    "geometry": "sdpp:geometry",
    "format": "sdpp:geometryFormat",
    "uri": { "@id": "sdpp:assetUri", "@type": "@id" },
    "hash": "sdpp:contentHash",
    "algorithm": "sdpp:hashAlgorithm",
    "value": "sdpp:hashValue",
    "locator": "sdpp:assetLocator",
    "scale_hint_m": "sdpp:scaleHintMeters",

    "physical": "sdpp:physicalProperties",
    "mass_kg": { "@id": "sdpp:massKilograms", "@type": "xsd:double" },
    "center_of_mass": { "@id": "sdpp:centerOfMass", "@container": "@list" },
    "density_kg_m3": "sdpp:densityKgM3",
    "friction": "sdpp:friction",
    "static": "sdpp:staticFrictionCoefficient",
    "kinetic": "sdpp:kineticFrictionCoefficient",
    "stiffness": "sdpp:stiffness",
    "youngs_modulus_pa": "sdpp:youngsModulusPa",
    "shear_modulus_pa": "sdpp:shearModulusPa",
    "poisson_ratio": "sdpp:poissonRatio",
    "joints": { "@id": "sdpp:hasJoint", "@container": "@set" },
    "axis": { "@id": "sdpp:jointAxis", "@container": "@list" },
    "limits": "sdpp:jointLimits",
    "lower_deg": "sdpp:limitLowerDegrees",
    "upper_deg": "sdpp:limitUpperDegrees",
    "lower_m": "sdpp:limitLowerMeters",
    "upper_m": "sdpp:limitUpperMeters",
    "parent": "sdpp:jointParent",
    "child": "sdpp:jointChild",

    "compliance": "sdpp:complianceRecord",
    "bill_of_materials": { "@id": "sdpp:hasBomEntry", "@container": "@set" },
    "material_composition": { "@id": "sdpp:hasMaterialFraction", "@container": "@set" },
    "material_id": "sdpp:materialId",
    "part_id": "sdpp:partId",
    "quantity": "sdpp:quantity",
    "fraction": "sdpp:massFraction",
    "recyclability_rate": "sdpp:recyclabilityRate",
    "dpp": "sdpp:digitalProductPassport",
    "passport_id": { "@id": "sdpp:passportId", "@type": "@id" },
    "sbom_ref": { "@id": "sdpp:sbomRef", "@type": "@id" },
    "hbom_ref": { "@id": "sdpp:hbomRef", "@type": "@id" },
    "repairability_score": "sdpp:repairabilityScore",
    "disassembly": "sdpp:disassemblyPlan",
    "plan_ref": { "@id": "sdpp:planRef", "@type": "@id" },
    "steps": { "@id": "sdpp:hasDisassemblyStep", "@container": "@list" },
    "order": "sdpp:stepOrder",
    "action": "sdpp:stepAction",
    "target": "sdpp:stepTarget",
    "tool": "sdpp:stepTool",
    "hazard": "sdpp:stepHazard",
    "note": "sdpp:stepNote",
    "cra": "sdpp:craRecord",
    "conformance": "sdpp:craConformance",
    "support_period_until": { "@id": "sdpp:supportPeriodUntil", "@type": "xsd:dateTime" },
    "vulnerability_disclosure_uri": { "@id": "sdpp:vulnerabilityDisclosureUri", "@type": "@id" },
    "logs": { "@id": "sdpp:hasCraLogEntry", "@container": "@set" },
    "timestamp": { "@id": "sdpp:logTimestamp", "@type": "xsd:dateTime" },
    "event": "sdpp:logEvent",
    "detail": "sdpp:logDetail"
  }
}
